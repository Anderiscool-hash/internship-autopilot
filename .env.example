# Copy this file to `.env` and fill in real values.
#
#     cp .env.example .env        (or copy it in Explorer and rename)
#
# `.env` is git-ignored and must NEVER be committed. This file documents the
# variable NAMES only, so a fresh clone knows what it needs to run.

# ---------------------------------------------------------------------------
# Database — matches the credentials in docker-compose.yml for local dev.
# In production this points at Amazon RDS instead (spec section 33).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://autopilot:autopilot_local_dev@localhost:5432/autopilot?schema=public"

# ---------------------------------------------------------------------------
# Queue — Redis backs BullMQ, which drives the continuous scanners and the
# application workers (spec sections 5 and 22).
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AI provider — used for requirement extraction, job-fit scoring, resume
# tailoring, cover letters, and ambiguous application answers.
# Set only the one you actually use; leave the rest blank.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Optional integrations — safe to leave blank until those phases are built.
# ---------------------------------------------------------------------------
# Gmail status tracking (spec section 25)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Contact enrichment for the recruiter finder (spec section 26)
HUNTER_API_KEY=""
PEOPLE_DATA_LABS_API_KEY=""

# Internship alerts (spec §28). Optional: with no URL set, alerts are still
# generated and recorded, they just print to the scanner's console. Any
# Discord-compatible webhook works — the body posted is {"content": "..."}.
ALERT_WEBHOOK_URL=""

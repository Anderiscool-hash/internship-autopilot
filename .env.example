# Copy this file to `.env` and fill in real values.
#
#     cp .env.example .env        (or copy it in Explorer and rename)
#
# `.env` is git-ignored and must NEVER be committed. This file documents the
# variable NAMES only, so a fresh clone knows what it needs to run.

# ---------------------------------------------------------------------------
# Database — matches the credentials in docker-compose.yml for local dev.
# In production this points at Amazon RDS instead (spec section 33).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://autopilot:autopilot_local_dev@localhost:5432/autopilot?schema=public"

# ---------------------------------------------------------------------------
# Queue — Redis backs BullMQ, which drives the continuous scanners and the
# application workers (spec sections 5 and 22).
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AI provider — used for requirement extraction, job-fit scoring, resume
# tailoring, cover letters, and ambiguous application answers.
# Set only the one you actually use; leave the rest blank.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Optional integrations — safe to leave blank until those phases are built.
# ---------------------------------------------------------------------------
# Gmail status tracking (spec section 25)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Contact enrichment for the recruiter finder (spec section 26)
HUNTER_API_KEY=""
PEOPLE_DATA_LABS_API_KEY=""

# Internship alerts (spec §28). Optional: with no URL set, alerts are still
# generated and recorded, they just print to the scanner's console. Any
# Discord-compatible webhook works — the body posted is {"content": "..."}.
ALERT_WEBHOOK_URL=""

# Password for reaching this app from anywhere other than the machine it runs
# on. Local requests never need it. Remote requests are REFUSED outright when
# this is unset, rather than served unlocked — this app holds work
# authorization, graduation date and resume history, and an unlocked public
# copy is a public copy of all of it.
APP_PASSWORD=""

# Turns the password off. ONLY for a copy that nothing else can reach.
#
# Set to exactly "1" and EVERY request is allowed through with no session and
# no password — not just requests that look local, every request, because this
# is read from the environment and never from the request. That is the point:
# a header cannot fake it, and it cannot be switched on by accident. It is also
# why it must NEVER be set on anything deployed, port-forwarded, tunnelled or
# otherwise reachable from another machine — there it is not "skip the login
# prompt", it is "publish this person's work authorization, graduation date,
# resume and answer bank to anyone who finds the URL".
#
# Any other value, including "true", "yes" and blank, means off.
# TRUST_LOCAL_REQUESTS=1

# ---- Mailbox, for emailed verification codes (optional) ---------------
# Some application portals will not let you past the first page until you
# confirm your address. With these set, `npm run shadow -- <jobId> --verify`
# reads the code out of your mailbox instead of making you go and find it.
#
# Scope, enforced in src/lib/email/inbox.ts: only the INBOX, only mail that
# arrives AFTER the run starts, opened read-only, nothing stored, connection
# closed when the code is found. Leave these unset and no mailbox is ever
# contacted — you are simply asked for the code like any other field.
#
# Gmail needs an APP PASSWORD here, not your account password:
#   https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=
# Set to "false" only for a local mail server without TLS.
IMAP_TLS=true

# ---- Where uploaded documents are kept (optional) ---------------------
# Defaults to ./storage/documents, which is gitignored. Your resume has your
# home address and phone number on it — keep this out of any synced folder.
# DOCUMENT_STORAGE_DIR=./storage/documents
